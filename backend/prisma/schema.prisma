generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
model Employee {
  id          Int      @id @default(autoincrement())
  fullName    String
  email       String   @unique
  country     String
  department  String
  jobTitle    String
  salary      Int
  dateOfJoining DateTime
  isActive    Boolean  @default(true)
}