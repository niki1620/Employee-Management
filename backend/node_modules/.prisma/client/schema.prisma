generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Employee {
  id          Int      @id @default(autoincrement())
  fullName    String
  email       String   @unique
  country     String
  department  String
  jobTitle    String
  salary      Float
  joiningDate DateTime
  status      String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
